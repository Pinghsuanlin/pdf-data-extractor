# Copy to .env and fill in what you use. Never commit .env.

# Which LLM backend to use: none | gemini | ollama | groq | mistral
LLM_BACKEND=none

# Google Gemini (reads text AND page images). Free key: https://aistudio.google.com/apikey
# Model ids change; if you get HTTP 404, copy the current "flash" model id from AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free tiers limit requests per minute (Gemini 2.5 Flash free tier: 5 per minute, 20 per day;
# check yours at https://ai.dev/rate-limit). 13 seconds between calls stays under 5 per minute.
LLM_MIN_INTERVAL_S=13

# Responses are cached here, so re-running an evaluation makes no new API calls.
LLM_CACHE_DIR=.cache/llm

# Local model via Ollama (free, runs on your machine, text only): `ollama pull mistral`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Other hosted free tiers (text only; check current limits and model names on each site)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
